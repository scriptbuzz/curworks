curwork_admin_settings.json
curwork_user_settings.json
.curwork-*.tmp
.curwork-write-test-*

# ---- Local working files (not part of the project) ----
RESUME_HERE.md

# ---- Test runs: results, logs and helper files ----
*_results.txt
code_tests_output.txt
curwork_run_output.txt
test_bucket.txt
.bucket_policy_test.json
CurWork-crash.log
*.log
.pytest_cache/
.coverage
htmlcov/

