# CurWork Beta 0.011 - DRAFT - For Internal Use (FPT) - test settings template - updated 2026-11-22 18:12 UTC - modified by: mbitar
# Copy this file to curwork_test.env and fill in your own values. curwork_test.env is in .gitignore and is
# never committed; the commit and push checks also block these values if they show up in any other file.

# The AWS account that holds the test bucket (12 digits)
CURWORK_ACCOUNT=000000000000
# Your AWS CLI profile with admin rights in that account (used only to create and remove test items)
CURWORK_ADMIN_PROFILE=your-admin-profile
# Your IAM Identity Center start URL and its Region
CURWORK_SSO_START_URL=https://your-org.awsapps.com/start
CURWORK_SSO_REGION=us-east-1
# Optional: a profile for the organization's management account, if the admin profile can't manage Identity Center
CURWORK_IC_PROFILE=

# Names the test creates (change only if they clash with something you already have)
CURWORK_SSO_SESSION=curwork-test
CURWORK_PROFILE=curwork-biller
CURWORK_ROLE=CurWorkBillerTest
