#!/bin/bash
# CurWork Beta 0.013 - DRAFT - For Internal Use (FPT) - updated 2026-11-22 23:56 UTC - modified by: mbitar
# Stops a push if any commit being pushed holds AWS details (also catches commits made with --no-verify).
TOP="$(git rev-parse --show-toplevel)"; Z=0000000000000000000000000000000000000000; RC=0
while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
  [ "$LOCAL_SHA" = "$Z" ] && continue
  if [ "$REMOTE_SHA" = "$Z" ]; then
    for C in $(git rev-list "$LOCAL_SHA" --not --remotes); do
      P=$(git rev-parse -q --verify "$C^" || git hash-object -t tree /dev/null)
      "$TOP/tools/check_no_aws_details.sh" --commits "$P..$C" || RC=1
    done
  else
    for C in $(git rev-list "$REMOTE_SHA..$LOCAL_SHA"); do
      "$TOP/tools/check_no_aws_details.sh" --commits "$C^..$C" || RC=1
    done
  fi
done
exit $RC
